      "name": "Auth",
      "item": [
        {
          "name": "Request Patient Access",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{username}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/request-patient-access",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "request-patient-access"
              ]
            }
          }
        },
        {
          "name": "Verify Patient Access",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{username}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-patient-access",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-patient-access"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('token', jsonData.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Request OTP (Doctor/Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
